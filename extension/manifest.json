{
  "manifest_version": 3,
  "name": "VINA",
  "version": "1.0.0",
  "description": "Private voice rooms with up to 10 participants while you browse.",
  "permissions": ["offscreen", "tabs", "storage", "microphone"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://vina-voice-chatting-extension.onrender.com/*"
  ],

  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Voice Chat",
    "default_popup": "popup/popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}