# Copy to .env on the VPS and replace every example value before starting Compose.
DOMAIN=voice.example.com
ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop

# Public IPv4 address of this VPS, advertised in Coturn relay candidates.
TURN_EXTERNAL_IP=203.0.113.10
TURN_REALM=voice.example.com
TURN_URLS=turn:voice.example.com:3478?transport=udp,turn:voice.example.com:3478?transport=tcp
TURN_SHARED_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
TURN_CREDENTIAL_TTL_SECONDS=3600

# Optional TURN over TLS. When enabled, install matching fullchain.pem and
# privkey.pem in coturn/certs before starting the Coturn service, and add
# turns:voice.example.com:5349?transport=tcp to TURN_URLS.
TURN_TLS=false
STUN_URLS=stun:stun.l.google.com:19302
MAX_ROOMS=5000
MAX_CONNECTIONS=1000